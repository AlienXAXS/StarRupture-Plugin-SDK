<?xml version="1.0" encoding="utf-8"?>
<!--
  PluginPresetsTests : console test for include/plugin_presets.h. Not part of the
  solution build. Build and run it with:

    msbuild Tests\PluginPresetsTests\PluginPresetsTests.vcxproj /p:Configuration=Release /p:Platform=x64
    build\tests\plugin_presets_tests.exe

  The stand-ins in Tests\PluginMapTests\stubs replace the game SDK headers, so nothing else is
  compiled. Pass a presets file as the first argument (or set PLUGIN_PRESETS_REAL_FILE) to also
  run the load-then-save round trip on it; the file is only read, the check uses a temp copy.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{3C5E8A12-6D47-4F90-B1A3-2E7F40D9C658}</ProjectGuid>
    <RootNamespace>PluginPresetsTests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)..\..\build\tests\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\..\obj\Tests\PluginPresetsTests\</IntDir>
    <TargetName>plugin_presets_tests</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions>_CONSOLE;NOMINMAX;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\PluginMapTests\stubs;$(MSBuildThisFileDirectory)..\..\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="plugin_presets_tests.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\..\include\plugin_presets.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
